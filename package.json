{
  "name": "real-analysis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "check-deps": "tsx scripts/check-deps.ts",
    "size": "tsx scripts/gen-size-budget.ts && size-limit"
  },
  "size-limit": [
    {
      "name": "home entry",
      "path": "dist/assets/home-*.js",
      "limit": "2 kB"
    },
    {
      "name": "shared shell chunks",
      "path": [
        "dist/assets/app-*.js",
        "dist/assets/tex-*.js",
        "dist/assets/sum-*.js",
        "dist/assets/clamp-*.js"
      ],
      "limit": "9 kB"
    },
    {
      "name": "shared view kit",
      "path": [
        "dist/assets/d3kit-*.js",
        "dist/assets/richslot-*.js",
        "dist/assets/richtext-*.js"
      ],
      "limit": "2 kB"
    },
    {
      "name": "shared other chunks",
      "path": [
        "dist/assets/errata-page-*.js",
        "dist/assets/search-*.js",
        "dist/assets/simple-scene-*.js",
        "dist/assets/simpson-*.js"
      ],
      "limit": "470 kB"
    },
    {
      "name": "chapter: proofs (entry + 10 scenes)",
      "path": [
        "dist/assets/proofs-*.js",
        "dist/assets/LogicPropositions-*.js",
        "dist/assets/Quantifiers-*.js",
