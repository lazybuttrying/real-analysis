    },
    {
      "name": "chapter: sequences (entry + 18 scenes)",
      "path": [
        "dist/assets/sequences-*.js",
        "dist/assets/epsilonN-*.js",
        "dist/assets/squeeze-*.js",
        "dist/assets/standardLimits-*.js",
        "dist/assets/norm-*.js",
        "dist/assets/innerProduct-*.js",
        "dist/assets/bounded-*.js",
        "dist/assets/subsequence-*.js",
        "dist/assets/sequenceSpaces-*.js",
