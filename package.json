        "dist/assets/FunctionProofs-*.js"
      ],
      "limit": "35 kB"
    },
    {
      "name": "chapter: numbers (entry + 19 scenes)",
      "path": [
        "dist/assets/numbers-*.js",
        "dist/assets/naturalNumbers-*.js",
        "dist/assets/binomial-*.js",
        "dist/assets/integersRationals-*.js",
        "dist/assets/absoluteValue-*.js",
        "dist/assets/archimedean-*.js",
        "dist/assets/complexNumbers-*.js",
        "dist/assets/sqrt2Irrational-*.js",
        "dist/assets/densityOfRationals-*.js",
        "dist/assets/sets-*.js",
        "dist/assets/supremum-*.js",
        "dist/assets/countable-*.js",
