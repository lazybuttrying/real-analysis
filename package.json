  "dependencies": {
    "d3": "^7.9.0",
    "katex": "^0.19.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@size-limit/file": "^14.2.0",
    "@types/d3": "^7.4.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "size-limit": "^14.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
